import json
import hashlib
from dataclasses import dataclass, field
from datetime import datetime
from typing import Any, Dict, List, Optional


# ── Data structures (identical to starter) ───────────────────────────────────

@dataclass
class ArtifactVersions:
    model_version: str
    prompt_hash: str
    index_id: str
    embedding_model: str
    dataset_hash: str
    judge_prompt_hash: str


@dataclass
class AggregateMetrics:
    goal_metric_score: float
    guardrail_passed: bool
    hallucination_rate: float
    latency_p50_ms: float
    latency_p95_ms: float
    cost_per_query_usd: float


@dataclass
class EvalRunRecord:
    run_id: str
    timestamp: str
    artifact_versions: ArtifactVersions
    aggregate_metrics: AggregateMetrics
    freshness: Optional[Dict] = None
    per_example_results_path: str = ""
    notes: str = ""


@dataclass
class GateCondition:
    name: str
    observed: float
    threshold: float
    direction: str
    passed: bool = field(init=False)
    gap: float = field(init=False)

    def __post_init__(self):
        if self.direction == "min":
            # Quality floor: gap positive = above floor (good).
            self.passed = self.observed >= self.threshold
            self.gap = self.observed - self.threshold
        else:
            # Ceiling: gap positive = below ceiling (good).
            self.passed = self.observed <= self.threshold
            self.gap = self.threshold - self.observed


@dataclass
class GateDecision:
    passed: bool
    conditions: Dict[str, GateCondition]
    annotation: str


# ── Exercise 1 ────────────────────────────────────────────────────────────────

def hash_file_content(content: str) -> str:
    # Explicit UTF-8 encoding prevents platform-specific encoding
    # differences from producing different hashes for the same content.
    return hashlib.sha256(content.encode("utf-8")).hexdigest()


def hash_dataset(examples: List[Dict]) -> str:
    # sort_keys=True is the critical argument — without it two dicts with
    # the same content but different insertion orders produce different
    # JSON strings and therefore different hashes.
    serialised = json.dumps(examples, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(serialised.encode("utf-8")).hexdigest()


# ── Exercise 2 ────────────────────────────────────────────────────────────────

def build_run_record(
    run_id: str,
    artifact_versions: ArtifactVersions,
    aggregate_metrics: AggregateMetrics,
    freshness: Optional[Dict] = None,
    per_example_results_path: str = "",
    notes: str = "",
) -> EvalRunRecord:
    # Timestamp at construction = when artifacts were locked, not when
    # the last example was scored. This is the semantically correct
    # moment for versioning purposes.
    return EvalRunRecord(
        run_id=run_id,
        timestamp=datetime.utcnow().isoformat(),
        artifact_versions=artifact_versions,
        aggregate_metrics=aggregate_metrics,
        freshness=freshness,
        per_example_results_path=per_example_results_path,
        notes=notes,
    )


def run_record_to_dict(record: EvalRunRecord) -> dict:
    av = record.artifact_versions
    am = record.aggregate_metrics
    return {
        "run_id": record.run_id,
        "timestamp": record.timestamp,
        "artifact_versions": {
            "model_version":     av.model_version,
            "prompt_hash":       av.prompt_hash,
            "index_id":          av.index_id,
            "embedding_model":   av.embedding_model,
            "dataset_hash":      av.dataset_hash,
            "judge_prompt_hash": av.judge_prompt_hash,
        },
        "aggregate_metrics": {
            "goal_metric_score":  round(am.goal_metric_score,  4),
            "guardrail_passed":   am.guardrail_passed,
            "hallucination_rate": round(am.hallucination_rate, 4),
            "latency_p50_ms":     round(am.latency_p50_ms,     4),
            "latency_p95_ms":     round(am.latency_p95_ms,     4),
            "cost_per_query_usd": round(am.cost_per_query_usd, 4),
        },
        "freshness": record.freshness,
        "per_example_results_path": record.per_example_results_path,
        "notes": record.notes,
    }


# ── Exercise 3 ────────────────────────────────────────────────────────────────

_NUMERIC_METRICS = [
    "goal_metric_score", "hallucination_rate",
    "latency_p50_ms", "latency_p95_ms", "cost_per_query_usd",
]


def diff_run_records(record_a: dict, record_b: dict) -> dict:
    av_a = record_a["artifact_versions"]
    av_b = record_b["artifact_versions"]
    changed = [k for k in av_a if av_a[k] != av_b[k]]

    am_a = record_a["aggregate_metrics"]
    am_b = record_b["aggregate_metrics"]
    deltas = {
        m: round(am_b[m] - am_a[m], 4)
        for m in _NUMERIC_METRICS
        if m in am_a and m in am_b
    }

    a_passed = am_a.get("guardrail_passed", False)
    b_passed = am_b.get("guardrail_passed", False)
    if a_passed and b_passed:
        status = "both_passed"
    elif not a_passed and not b_passed:
        status = "both_failed"
    elif not a_passed and b_passed:
        status = "newly_passed"
    else:
        status = "newly_failed"

    return {
        "changed_artifacts": changed,
        "metric_deltas": deltas,
        "guardrail_status": status,
    }


# ── Exercise 4 ────────────────────────────────────────────────────────────────

def find_regression(
    run_history: List[dict],
    metric: str,
    threshold: float,
) -> Optional[dict]:
    for record in run_history:
        value = record.get("aggregate_metrics", {}).get(metric)
        if value is not None and value < threshold:
            return record
    return None


def attribute_regression(run_a: dict, run_b: dict) -> str:
    diff = diff_run_records(run_a, run_b)
    changed = diff["changed_artifacts"]

    if len(changed) == 0:
        return (
            "No artifact changes detected. Check for distribution shift "
            "or tool/infrastructure changes."
        )
    if len(changed) == 1:
        artifact = changed[0]
        old_val = run_a["artifact_versions"][artifact]
        new_val = run_b["artifact_versions"][artifact]
        return f"Likely cause: {artifact} changed ({old_val} → {new_val})"

    return (
        f"Multiple artifacts changed: {', '.join(changed)}. "
        f"Isolate changes and re-run to identify root cause."
    )


# ── Exercise 5: Offline gate ──────────────────────────────────────────────────

def evaluate_gate(
    run_record: dict,
    quality_floor: float,
    hallucination_ceiling: float,
    cost_ceiling_usd: float,
    latency_p95_ceiling_ms: float,
) -> GateDecision:
    metrics = run_record.get("aggregate_metrics", {})

    # Safe defaults guarantee failure when a metric is absent — the gate
    # must never silently pass because a metric was not recorded.
    conditions = {
        "quality_floor": GateCondition(
            name="Quality floor",
            observed=metrics.get("goal_metric_score", 0.0),
            threshold=quality_floor,
            direction="min",
        ),
        "hallucination_ceiling": GateCondition(
            name="Hallucination rate ceiling",
            observed=metrics.get("hallucination_rate", 1.0),
            threshold=hallucination_ceiling,
            direction="max",
        ),
        "cost_ceiling": GateCondition(
            name="Cost ceiling",
            observed=metrics.get("cost_per_query_usd", 999.0),
            threshold=cost_ceiling_usd,
            direction="max",
        ),
        "latency_ceiling": GateCondition(
            name="Latency P95 ceiling",
            observed=metrics.get("latency_p95_ms", 999_999.0),
            threshold=latency_p95_ceiling_ms,
            direction="max",
        ),
    }

    all_passed = all(c.passed for c in conditions.values())
    failed = [c for c in conditions.values() if not c.passed]

    if all_passed:
        annotation = (
            "All four gate conditions passed. "
            "System approved to advance to shadow deployment."
        )
    elif len(failed) == 1:
        c = failed[0]
        direction_word = (
            "above ceiling" if c.direction == "max" else "below floor"
        )
        annotation = (
            f"Gate blocked on {c.name}. "
            f"Observed {c.observed:.4f} is {direction_word} "
            f"{c.threshold:.4f} by {abs(c.gap):.4f}. "
            f"Close this gap before re-evaluation."
        )
    else:
        names = ", ".join(c.name for c in failed)
        annotation = (
            f"Gate blocked on {len(failed)} conditions: {names}. "
            f"All failures must be resolved before re-evaluation."
        )

    return GateDecision(
        passed=all_passed,
        conditions=conditions,
        annotation=annotation,
    )


def print_gate_report(decision: GateDecision) -> None:
    width = 54
    status = "PASS ✓" if decision.passed else "BLOCK ✗"
    print(f"\n{'=' * width}")
    print(f"  Offline gate: {status}")
    print(f"{'=' * width}")
    for c in decision.conditions.values():
        symbol = "✓" if c.passed else "✗"
        if c.gap >= 0:
            gap_str = f"{c.gap:.4f} within threshold"
        elif c.direction == "max":
            gap_str = f"{abs(c.gap):.4f} above ceiling"
        else:
            gap_str = f"{abs(c.gap):.4f} below floor"
        print(f"  {symbol} {c.name}")
        print(f"    Observed: {c.observed:.4f}  "
              f"Threshold: {c.threshold:.4f}  ({gap_str})")
    print(f"\n  {decision.annotation}\n")


def gate_and_record(
    run_record: dict,
    quality_floor: float,
    hallucination_ceiling: float,
    cost_ceiling_usd: float,
    latency_p95_ceiling_ms: float,
) -> dict:
    decision = evaluate_gate(
        run_record,
        quality_floor=quality_floor,
        hallucination_ceiling=hallucination_ceiling,
        cost_ceiling_usd=cost_ceiling_usd,
        latency_p95_ceiling_ms=latency_p95_ceiling_ms,
    )
    # Shallow copy — do not mutate the caller's run record.
    enriched = {**run_record}
    enriched["gate_decision"] = {
        "passed": decision.passed,
        "annotation": decision.annotation,
        "conditions": {
            key: {
                "name":      c.name,
                "observed":  round(c.observed,  4),
                "threshold": round(c.threshold, 4),
                "passed":    c.passed,
                "gap":       round(c.gap,       4),
            }
            for key, c in decision.conditions.items()
        },
    }
    return enriched


